#!name=广告平台拦截器
#!desc=精简版：只保留国内外主流广告平台 / 广告 SDK / 归因统计的拦截，去掉小众联盟与重复规则。作为去广告的基础模块，请排序在顶部，并搭配其他去广告插件使用。\n\n覆盖：字节跳动(穿山甲)、快手、百度、腾讯(优量汇)、阿里(Tanx/汇川/百川)、网易、小米、美团、京东、拼多多、讯飞、友盟、个推、极光、MobTech、OpenInstall、AdScope(倍孜)、天目(艾狄墨搏)、TopOn、Sigmob、推啊、多盟、秒针、Google、AppLovin、Unity、ironSource、Vungle、Mintegral、InMobi、Moloco、TradPlus、Tapjoy、The Trade Desk、Adjust、AppsFlyer、Amazon。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Website_icon/120px/TencentAd.png
#!category=BetaModule
#!tag=去广告, 依赖
#!homepage=https://hub.kelee.one
#!date=2026-10-13

[Rule]
# ===== 字节跳动 / 穿山甲 =====
AND,((DOMAIN-KEYWORD,tnc,extended-matching),(OR,((DOMAIN-SUFFIX,capcutapi.com,extended-matching),(DOMAIN-SUFFIX,zijieapi.com,extended-matching),(DOMAIN-SUFFIX,isnssdk.com,extended-matching),(DOMAIN-SUFFIX,toutiaoapi.com,extended-matching),(DOMAIN-SUFFIX,bytedance.com,extended-matching),(DOMAIN-SUFFIX,snssdk.com,extended-matching),(DOMAIN-SUFFIX,sgsnssdk.com,extended-matching)))),REJECT-DROP
DOMAIN-KEYWORD,adstrategy,REJECT,extended-matching,pre-matching
AND,((DOMAIN-KEYWORD,-ad-,extended-matching),(DOMAIN-SUFFIX,byteimg.com,extended-matching)),REJECT,pre-matching
AND,((DOMAIN-KEYWORD,ads,extended-matching),(DOMAIN-KEYWORD,-normal.zijieapi.com,extended-matching)),REJECT,pre-matching
DOMAIN,lf-ad-ies.bytecdn.cn,REJECT,extended-matching,pre-matching
DOMAIN,dig.bdurl.net,REJECT-DROP,extended-matching,pre-matching
DOMAIN,extlog.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN,mcs.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,bds.snssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,byteadverts.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT,extended-matching,pre-matching
DOMAIN-SUFFIX,pangle.io,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,pangolin,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,pglstatp,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,panplayable-toutiao,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,-ad.byteoversea.com,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,asiad.byteactivity,REJECT,extended-matching,pre-matching

