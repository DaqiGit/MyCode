#!name=高德地图去广告
#!desc=移除开屏广告、首页推荐、搜索推荐、打车广告、地点推荐及广告，精简我的页面。改写自可莉 Loon 插件（2026-10-20 12:06:08 版）
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Amap.png
#!category=zky-modified

[Map Local]
# 开屏广告
^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\? data-type=text data="{}" status-code=200

# 首页资源位 / AI 推荐问题
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets\? data-type=text data="{}" status-code=200
^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs\? data-type=text data="{}" status-code=200
^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs\? data-type=text data="{}" status-code=200

# 打车推广资源位
^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\? data-type=text data="{}" status-code=200

# 榜单卡片 / 搜索营销位
^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard\? data-type=text data="{}" status-code=200
^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\? data-type=text data="{}" status-code=200

[Body Rewrite]
# 全局配置：删除广告、弹窗、活动等配置项，再执行可莉的 updatable.jq
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\? 'del(.data.adStatementConfig, .data.adCustomerRetainArchitecture, .data.adImEntryConfig, .data.adVenueConfig, .data.adPerfSwitch, .data.EndNaviC3AdCard, .data.infoCpcReport, .data.hotsaleConfig, .data.marketing_resource_config, .data.coupon_risk_asac, .data.commonCouponSceneLog, .data.sug_coupon_opt, .data.giftEntryConfig, .data.splashscreen, .data.SplashScreenControl, .data.splashview_config, .data.feedback_banner, .data.TrainOrderBanner, .data.nearby_business_popup, .data.shortcut_popup_frequency, .data.tel_retention_popup, .data.hotel_activity, .data.taxi_activity, .data.hotel_privilege, .data.sportsActivityConfig, .data.activity_qingke_contry_control, .data["920bestwishes"], .data.custom_consultdata.widget_guide, .data.free_ride, .data.homepage_resource_config, .data.home_message_guide, .data.hotel_tipsicon, .data.sur_bar, .data.nearby_map_entry_guide, .data.comment_info, .data.small_biz_index, .data.small_biz_fun, .data.setpagesearch, .data.wallet)'
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\? jq-path="https://kelee.one/Resource/JQLang/Amap/updatable.jq"

# 我的页面：只保留足迹卡片和常用入口
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\? 'del(.data.tipData, .data.wallet) | .data.cardList |= map(select(.dataKey == "MineNewFootprintCard" or .dataKey == "MineNewBEntranceCardV4")) | (.data.cardList[] | select(.dataKey == "MineNewBEntranceCardV4") | .content.entranceList_1) |= map(select(.id == 7 or .id == 8 or .id == 10 or .id == 17)) | (.data.cardList[] | select(.dataKey == "MineNewBEntranceCardV4") | .content.entranceList_2) |= map(select(.id == 32 or .id == 4 or .id == 9 or .id == 16 or .id == 14))'

# 首页搜索框：删除底纹词，精简工具推荐（原插件随后对 shadingWords 的过滤在删除后已无作用，故省略）
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\? 'del(.data.shadingWords) | .data.toolsRecommend.data.default |= map(select(.id == 102 or .id == 103 or .id == 106 or .id == 151))'

# 工具箱：去角标，移除 id 547
http-response-jq ^https:\/\/sns\.amap\.com\/ws\/opc\/tools\/list\? '(if (type == "object") and ((.data | type) == "object") and ((.data.category | type) == "array") then (.data.category[] | select(type == "object") | .tools | select(type == "array") | .[] | select(type == "object")) |= del(.tips) else . end) | (if (type == "object") and ((.data | type) == "object") and ((.data.category | type) == "array") then (.data.category[] | select(type == "object") | .tools | select(type == "array")) |= map(select(if type == "object" then (((.id | type) == "string" and .id == "547") or ((.id | type) == "number" and .id == 547)) | not else true end)) else . end)'

# 搜索页快捷入口：清空角标文字
http-response-jq ^https:\/\/info\.amap\.com\/ws\/c3frontend\/af-search\/search\? 'if (try (.data.modules.quickLink.data.list | type) catch null) == "array" then .data.modules.quickLink.data.list |= map(if type == "object" and (.badge | type) == "object" and (.badge | has("text")) then .badge.text = "" else . end) else . end'

# 打车页：删除皮肤、气泡、弹窗，金刚区只保留城际 / 顺风车 / 代驾 / 优享 / 包车
http-response-jq ^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info\? 'del(.data.lubanData.skin, .data.lubanData.kingToolBoxBubble, .data.lubanData.popup) | def on_path($p; $t; f): if (try (getpath($p) | type == $t) catch false) then getpath($p) |= f else . end; (on_path(["data","lubanData","kingToolSort","dataList"]; "array"; map(if type == "object" then (if ((try (.biz | type) catch null) == "object" and (.biz | has("kingToolIdList"))) then (.biz.kingToolIdList |= (if type == "array" then map(select(IN("dache_toolbox_GDIntercity","dache_toolbox_hitch","dache_toolbox_chauffeur","dache_toolbox_quality","dache_toolbox_charterCar"))) else . end)) else . end) else . end))) | on_path(["data","lubanData","kingToolBox","dataList"]; "array"; map(select(if type == "object" then ((try (.biz | type) catch null) == "object" and (try (.biz.id | IN("dache_toolbox_GDIntercity","dache_toolbox_hitch","dache_toolbox_chauffeur","dache_toolbox_quality","dache_toolbox_charterCar")) catch false)) else false end)))'

# 顺风车横幅
http-response-jq ^https:\/\/m5-zb\.amap\.com\/ws\/amap\/hitch\/passenger\/content_info\? 'del(.data.lubanData.banner)'

# 消息中心推广列表
http-response-jq ^https:\/\/center\.amap\.com\/ws\/amc\/server\/conv\/raise_list\? 'def on_path($p; $t; f): if (try (getpath($p) | type == $t) catch false) then getpath($p) |= f else . end; on_path(["data","dataList"]; "array"; map(select(if type == "object" then (has("categoryId") or ((.data | type) == "object" and .data.id == "M_100007")) else false end)))'

# 搜索联想：只保留普通结果
http-response-jq ^https:\/\/info\.amap\.com\/ws\/shield\/search_business\/process\/middleLayer\/sug\? '.tip_list |= map(select(.tip.task_tag == "common_content_general" or .tip.task_tag == "sp"))'

# 地点详情页：去写评价引导，再执行可莉的 search_poi_detail.jq
http-response-jq ^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\? 'del(.data.modules.combineReviews.data.write_comment.btnRightTag, .data.modules.combineReviews.data.write_comment.title)'
http-response-jq ^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\? jq-path="https://kelee.one/Resource/JQLang/Amap/search_poi_detail.jq"

# 附近推荐运营活动
http-response-jq ^https:\/\/m5\.amap\.com\/ws\/smartui\/near_recommend\? 'del(.data.operation_activity)'

[MITM]
hostname = %APPEND% m5.amap.com, ai.amap.com, m5-zb.amap.com, center.amap.com, sns.amap.com, info.amap.com
