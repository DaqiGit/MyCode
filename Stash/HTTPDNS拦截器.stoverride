http:
  mitm:
    - "appconf.mail.163.com"
    - "msglb.91160.com"
    - "ucdc-upaas.uc.cn"
    - "ucdc*-upaas.uc.cn"
    - "cdn.wup.huya.com"
    - "gslbali.ximalaya.com"
  url-rewrite:
    - "^http:\\/\\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\\/v?[0-9]+)?\\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\\? - reject"
    - "^http:\\/\\/\\[[0-9a-fA-F:]+\\](?:\\/v?[0-9]+)?\\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\\? - reject"
    - "^http:\\/\\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\\d+\\/httpdns\\/ - reject"
    - "^http:\\/\\/\\[[0-9a-fA-F:]+\\]:\\d+\\/httpdns\\/ - reject"
    - "^http:\\/\\/103\\.44\\.58\\.64\\/md\\? - reject"
    - "^http:\\/\\/103\\.37\\.155\\.60\\/fetch - reject"
    - "^http:\\/\\/103\\.41\\.167\\.237\\/v2\\/resolv - reject"
    - "^http:\\/\\/cdn\\.wup\\.huya\\.com\\/launch\\/queryHttpDns - reject"
    - "^http:\\/\\/xmc\\.ximalaya\\.com\\/xmlymain-login-web\\/login\\/ - reject"
    - "^http:\\/\\/api\\.weibo\\.cn\\/(?:\\d+\\/)?httpdns\\/config - reject"
    - "^https?:\\/\\/cdn\\.wup\\.huya\\.com\\/monitor\\/monitor\\.jsp - reject"
    - "^https:\\/\\/gslbali\\.ximalaya\\.com\\/linkeye-cloud\\/httpdns\\/ - reject"
    - "^https?:\\/\\/appconf\\.mail\\.163\\.com\\/mailmaster\\/api\\/http\\/urlConfig\\.do$ - reject-dict"
    - "^https:\\/\\/msglb\\.91160\\.com\\/msg\\/outer\\/broker\\/get$ - reject-dict"
    - "^https:\\/\\/ucdc\\d?-upaas\\.uc\\.cn\\/api\\/v\\d\\/dns_query\\? - reject-dict"
