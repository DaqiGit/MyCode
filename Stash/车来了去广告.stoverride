name: "车来了去广告"
desc: "去除车来了开屏广告、首页和详情页广告，精简底部标签栏"
author: "@ddgksf2013"
icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Bus.png"
category: "zky"

rules:
  - "DOMAIN-SUFFIX,yg84.com,REJECT"
  - "DOMAIN-SUFFIX,innoads.cn,REJECT"

http:
  mitm:
    - "api.chelaile.net.cn"
    - "atrace.chelaile.net.cn"
    - "web.chelaile.net.cn"
    - "pic1.chelaile.net.cn"
  url-rewrite:
    - "^https?:\\/\\/api\\.chelaile\\.net\\.cn\\/(goocity\\/)?advert\\/ - reject"
    - "^https?:\\/\\/atrace\\.chelaile\\.net\\.cn\\/advert\\/ - reject"
    - "^https?:\\/\\/atrace\\.chelaile\\.net\\.cn\\/exhibit\\?&adv_image - reject"
    - "^https?:\\/\\/pic1\\.chelaile\\.net\\.cn\\/adv\\/ - reject"
    - "^http:\\/\\/\\d+\\.\\d+\\.\\d+\\.\\d+\\/adpub\\/ - reject"
    - "^https?:\\/\\/api\\.chelaile\\.net\\.cn\\/tapi\\/cardv2\\/ - reject"
    - "^https?:\\/\\/web\\.chelaile\\.net\\.cn\\/api\\/advert\\/ - reject"
    - "^https?:\\/\\/api\\.chelaile\\.net\\.cn\\/tapi\\/common\\/ - reject"
  script:
    - match: "^https?:\\/\\/api\\.chelaile\\.net\\.cn\\/goocity\\/city"
      name: "车来了标签栏"
      type: "response"
      require-body: true
      timeout: 5

script-providers:
  "车来了标签栏":
    url: "https://raw.githubusercontent.com/DaqiGit/MyCode/main/chelaile.js"
    interval: 86400
